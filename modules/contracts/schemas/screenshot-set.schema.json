{
  "dialect": "draft-2020-12",
  "schema": {
    "type": "object",
    "properties": {
      "schemaVersion": {
        "type": "string"
      },
      "gameBuildId": {
        "type": "string"
      },
      "mapName": {
        "type": "string"
      },
      "fov": {
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 180
      },
      "hideHud": {
        "type": "boolean"
      },
      "placeholder": {
        "type": "boolean"
      },
      "tool": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "version"
        ],
        "additionalProperties": true
      },
      "shots": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "group": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "requested": {
              "type": "object",
              "properties": {
                "position": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "maxItems": 3,
                  "minItems": 3
                },
                "angles": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "maxItems": 3,
                  "minItems": 3
                }
              },
              "required": [
                "position",
                "angles"
              ],
              "additionalProperties": true
            },
            "actual": {
              "type": "object",
              "properties": {
                "position": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "maxItems": 3,
                  "minItems": 3
                },
                "angles": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "maxItems": 3,
                  "minItems": 3
                }
              },
              "required": [
                "position",
                "angles"
              ],
              "additionalProperties": true
            },
            "lookAt": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "maxItems": 3,
              "minItems": 3
            },
            "file": {
              "type": "string"
            },
            "thumbnail": {
              "type": "string"
            },
            "bytes": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string",
                  "enum": [
                    "Infinity",
                    "-Infinity",
                    "NaN"
                  ]
                }
              ]
            },
            "sha256": {
              "type": "string"
            },
            "width": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "height": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "capturedAt": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "requested",
            "file",
            "bytes",
            "sha256",
            "width",
            "height",
            "capturedAt"
          ],
          "additionalProperties": true
        }
      }
    },
    "required": [
      "schemaVersion",
      "gameBuildId",
      "mapName",
      "fov",
      "hideHud",
      "shots"
    ],
    "additionalProperties": true
  },
  "definitions": {}
}
